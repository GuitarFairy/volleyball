{
  "name": "volleyball-recorder",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python -m http.server 8000 --directory dist",
    "test:ui": "node tests/ui-flow.mjs",
    "dev": "node scripts/cloudflare.mjs dev",
    "deploy": "node scripts/cloudflare.mjs deploy",
    "db:migrate": "node scripts/cloudflare.mjs d1 migrations apply hwaiq-volleyball --remote",
    "test:browser:serve": "node tests/browser-server.mjs"
  },
  "devDependencies": {
    "esbuild-wasm": "0.28.2",
    "jsdom": "30.1.3",
    "wrangler": "4.151.0"
  }
}
